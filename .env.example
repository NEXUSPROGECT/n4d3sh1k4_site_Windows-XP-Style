SECRET_KEY=your-very-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

DB_NAME=portfolio
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=db
DB_PORT=5432

# MinIO (S3-compatible storage for media files)
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=portfolio
MINIO_ENDPOINT=http://minio:9000
# Public domain через который браузер загружает файлы.
# Для прямого доступа: yourdomain.com:9000/portfolio
# Через nginx-proxy: yourdomain.com/media
MINIO_PUBLIC_DOMAIN=yourdomain.com:9000/portfolio
MINIO_SECURE=False
